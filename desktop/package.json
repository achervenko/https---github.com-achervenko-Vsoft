{
  "name": "vsoft-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build": "vite build --base=./",
    "start": "npm run build && electron .",
    "package:win": "cargo build --locked --release --manifest-path ../Cargo.toml && npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.1",
    "vite": "8.3.8"
  }
}
